# --- LLM (obligatorias) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5-5
# Opcional. Los modelos actuales rechazan valores no default.
# TEMPERATURE=0

# --- Orquestador ---
# Máximo de delegaciones a especialistas por consulta (freno del "supervisor infinito").
MAX_STEPS=6
# Desde este monto (en pesos), registrar una solicitud requiere aprobación humana.
HITL_MONTO_UMBRAL=1000000

# --- RAG (obligatorias) ---
CHROMA_COLLECTION=politicas_credito
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# --- Cola y worker ---
QUEUE_NAME=intelligence:jobs
WORKER_CONCURRENCY=2

# --- Observabilidad ---
TRACING_ENABLED=true
PHOENIX_PROJECT_NAME=intelligence-system

# Con docker compose, REDIS_URL, CHROMA_HOST/PORT y PHOENIX_COLLECTOR_ENDPOINT los fija
# docker-compose.yml. Solo hace falta definirlas para correr la app fuera de Docker:
# REDIS_URL=redis://localhost:6379
# CHROMA_HOST=localhost
# CHROMA_PORT=8001
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
